<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{
      --accent:{{ settings.color_accent }};
      --accent-soft:{{ settings.color_accent_soft }};
      --ink:{{ settings.color_ink }};
      --muted:{{ settings.color_muted }};
      --surface:{{ settings.color_surface }};
      --hero:{{ settings.color_hero }};
      --line:{{ settings.color_line }};
      --ok:{{ settings.color_ok }};
      --black:{{ settings.color_black }};
      --subscribe:{{ settings.color_subscribe }};
    }
  </style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body class="template-{{ request.page_type | handleize }}">
  <a class="skip" href="#main">Skip to content</a>
  {% section 'header' %}
  <main id="main">{{ content_for_layout }}</main>
  {% section 'footer' %}
</body>
</html>
