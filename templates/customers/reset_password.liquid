<div class="wrap"><div class="auth">
  <h1>Reset password</h1>
  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}<div class="msg msg--err">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="NP">New password</label><input type="password" name="customer[password]" id="NP" autocomplete="new-password" required></div>
    <div class="field"><label for="NC">Confirm password</label><input type="password" name="customer[password_confirmation]" id="NC" autocomplete="new-password" required></div>
    <button class="btn" type="submit">Reset password</button>
  {%- endform -%}
</div></div>
