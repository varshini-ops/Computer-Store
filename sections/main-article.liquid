<article class="wrap narrow section prose"><h1>{{ article.title }}</h1><p class="muted">{{ article.published_at | date: '%B %d, %Y' }}</p>{%- if article.image -%}{{ article.image | image_url: width: 1000 | image_tag: alt: article.title }}{%- endif -%}{{ article.content }}</article>
{% schema %}
{ "name": "Article" }
{% endschema %}
