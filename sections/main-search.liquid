<div class="wrap">
  <nav class="crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><span aria-current="page">Search</span></nav>
  <div class="chead"><h1>{% if search.performed %}Results for “{{ search.terms | escape }}”{% else %}Search{% endif %}</h1></div>
  <form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;gap:10px;max-width:560px;margin:20px 0 28px">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search laptops, PCs, accessories" aria-label="Search"><input type="hidden" name="type" value="product">
    <button class="btn" type="submit">Search</button>
  </form>
  {%- paginate search.results by 12 -%}
    {%- if search.performed and search.results_count > 0 -%}
      <p class="muted">{{ search.results_count }} result{% if search.results_count > 1 %}s{% endif %}</p>
      <div class="pgrid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- else -%}<a class="card-box" href="{{ item.url }}"><h3>{{ item.title }}</h3></a>{%- endif -%}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- elsif search.performed -%}
      <div class="empty"><h2>No results found</h2><p class="muted">Check the spelling or try a different search term.</p><a class="btn" href="{{ routes.all_products_collection_url }}">Shop all products</a></div>
    {%- endif -%}
  {%- endpaginate -%}
</div>
{% schema %}
{ "name": "Search" }
{% endschema %}
