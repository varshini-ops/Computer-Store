{%- capture nl %}
{% endcapture -%}
{%- assign first_block = section.blocks.first -%}
<section class="wrap section">
  <div class="sec-head"><div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.subheading }}</p></div></div>
  {%- if first_block != blank and first_block.settings.product != blank -%}
    <div class="cmp" style="--cols:{{ section.blocks.size }}">
      <div class="cmp__row cmp__head">
        <span></span>
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          {%- if p != blank -%}
          <a class="cmp__prod" href="{{ p.url }}" {{ block.shopify_attributes }}>
            <span class="cmp__img">{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: p.title }}{%- endif -%}</span>
            <span><strong>{{ p.title }}</strong><em>{{ p.price | money_without_trailing_zeros }}</em></span>
          </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- assign base_lines = first_block.settings.product.metafields.custom.specs.value | default: '' | split: nl -%}
      {%- for base in base_lines -%}
        {%- assign idx = forloop.index0 -%}
        {%- assign label = base | split: ':' | first | strip -%}
        {%- if label != blank -%}
        <div class="cmp__row">
          <span>{{ label }}</span>
          {%- for block in section.blocks -%}
            {%- assign lines = block.settings.product.metafields.custom.specs.value | default: '' | split: nl -%}
            {%- assign line = lines[idx] | default: '' -%}
            <span>{{ line | remove_first: label | remove_first: ':' | strip | default: '—' }}</span>
          {%- endfor -%}
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- else -%}<p class="empty muted">Choose products in this section to compare them.</p>{%- endif -%}
</section>

{% schema %}
{
  "name": "Compare table",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Compare Somato PCs" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Specifications from the Somato product sheet" }
  ],
  "blocks": [{ "type": "product", "name": "Product", "settings": [{ "type": "product", "id": "product", "label": "Product" }] }],
  "max_blocks": 4,
  "presets": [{ "name": "Compare table", "blocks": [{ "type": "product" }, { "type": "product" }, { "type": "product" }] }]
}
{% endschema %}
