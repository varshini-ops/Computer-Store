<section class="wrap" style="padding-top:25px;padding-bottom:25px">
  <div class="news">
    <div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div>
    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}<p class="msg" style="margin:0">Thanks for subscribing.</p>{%- else -%}
      <input type="email" name="contact[email]" placeholder="Enter your email address" aria-label="Email address" required>
      <button class="btn btn--red" type="submit">Subscribe</button>{%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stay updated" },
    { "type": "text", "id": "text", "label": "Text", "default": "Get the latest offers and new Somato launches straight to your inbox." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
