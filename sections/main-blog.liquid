<div class="wrap section"><h1>{{ blog.title }}</h1>
{%- paginate blog.articles by 9 -%}
  <div class="pgrid">
    {%- for article in blog.articles -%}
      <a class="card-box" href="{{ article.url }}" style="text-decoration:none">{%- if article.image -%}{{ article.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: article.title }}{%- endif -%}<h3>{{ article.title }}</h3><p class="muted">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p></a>
    {%- endfor -%}
  </div>
  {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
{%- endpaginate -%}</div>
{% schema %}
{ "name": "Blog" }
{% endschema %}
