<section class="wrap hero">
  <div class="hero__panel">
    <div class="hero__text">
      {%- if section.settings.tag != blank -%}<span class="tag">{{ section.settings.tag }}</span>{%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.text }}</p>
      <div class="hero__btns">
        {%- if section.settings.button_label != blank -%}<a class="btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
        {%- if section.settings.button2_label != blank -%}<a class="btn btn--white" href="{{ section.settings.button2_link | default: routes.collections_url }}">{{ section.settings.button2_label }}</a>{%- endif -%}
      </div>
    </div>
    <div class="hero__art">
      {%- if section.settings.image -%}{{ section.settings.image | image_url: width: 1200 | image_tag: widths: '500, 800, 1200', sizes: '(min-width: 1000px) 45vw, 90vw', loading: 'eager', alt: section.settings.heading }}{%- else -%}{{ 'hero-apparel-1' | placeholder_svg_tag }}{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "tag", "label": "Tag", "default": "NEW  |  SOMATO CORE FLEX" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Laptops that flex with you" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Ryzen 7 performance, a 360° convertible touchscreen and a digital pen in the box." },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Primary link" },
    { "type": "text", "id": "button2_label", "label": "Secondary button", "default": "View Collection" },
    { "type": "url", "id": "button2_link", "label": "Secondary link" },
    { "type": "image_picker", "id": "image", "label": "Hero image (laptop + all-in-one cut-out PNG)" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
